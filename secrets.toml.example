# Copy this file to .streamlit/secrets.toml and fill in your own values.
# .streamlit/secrets.toml is gitignored and must never be committed.

NEO4J_URI = "neo4j+s://<instance-id>.databases.neo4j.io"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = ""
NEO4J_DATABASE = "neo4j"

OPENAI_API_KEY = ""

# Optional: override the OpenAI models (defaults shown).
# OPENAI_PARSE_MODEL = "gpt-5.4-mini"
# OPENAI_ANSWER_MODEL = "gpt-5.4"
